# SQLite DB 경로 (로컬: ./autoblog.db, Render: /var/data/autoblog.db)
DATABASE_PATH=./autoblog.db

# AI API Keys
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key

# AI 설정 (선택)
GEMINI_TIMEOUT=20
OPENAI_TIMEOUT=45
# OpenAI는 잔액이 있을 때만 true
OPENAI_ENABLED=false

# Admin API (선택 — 설정 시 /admin/* 엔드포인트 활성화)
ADMIN_TOKEN=your_long_random_secret
