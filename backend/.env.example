# SQLite DB 경로
# 로컬: ./autoblog.db
# Render Starter + Disk: /var/data/autoblog.db
# 서버는 /var/data 가 쓰기 가능하면 자동으로 그쪽 DB를 씁니다.
DATABASE_PATH=./autoblog.db
# LICENSE_VAULT_PATH=/var/data/licenses.vault.json

# AI API Keys
GEMINI_API_KEY=your_gemini_key
OPENAI_API_KEY=your_openai_key

# AI 설정 (선택)
GEMINI_TIMEOUT=90
OPENAI_TIMEOUT=45
# Gemini 실패 시 GPT-4o-mini. Render에도 OPENAI_ENABLED=true 권장
OPENAI_ENABLED=true

# Admin API (선택 — 설정 시 /admin/* 엔드포인트 활성화)
ADMIN_TOKEN=your_long_random_secret

# 모바일 웹·구독 안내 (선택 — 미설정 시 business_config 기본값)
# BUSINESS_MONTHLY_PRICE=24900
# BUSINESS_YEARLY_PRICE=249000
# BUSINESS_SEMI_ANNUAL_PRICE=124500
# BUSINESS_LEGACY_MONTHLY_PRICE=12900
# BUSINESS_BLOG_MONTHLY_PRICE=12900
# BUSINESS_BLOG_SEMI_ANNUAL_PRICE=64500
# BUSINESS_BLOG_YEARLY_PRICE=129000
# BUSINESS_BANK_NAME=하나은행
# BUSINESS_ACCOUNT_NUMBER=365-910996-44807
# BUSINESS_ACCOUNT_HOLDER=신일
# BUSINESS_CONTACT=070-8065-1258
# BUSINESS_CONTACT_METHOD=카톡/문자
# BUSINESS_CONTACT_EMAIL=acrosstool@gmail.com
