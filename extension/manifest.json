{
  "manifest_version": 3,
  "name": "오토블로그 AI - 사장님 현장 일기",
  "version": "1.0.4",
  "description": "3분 체크로 끝내는 네이버 블로그 현장 작업 후기 반자동 작성",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "*://blog.naver.com/*",
    "http://127.0.0.1:8000/*",
    "https://blog-chrometool.onrender.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "오토블로그 패널 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://blog.naver.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
